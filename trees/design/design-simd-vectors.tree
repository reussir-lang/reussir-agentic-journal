\subtree[design-simd-vectors-open]{
\title{Left out}

\ol{
\li{\strong{\code{\verb~|contract~}.} Deferred until the language has affine maps.}
\li{\strong{Element types.} \code{\verb~|f16~}, \code{\verb~|bf16~}, \code{\verb~|i128~} and \code{\verb~|char~} lanes, and vectors of pointers. \code{\verb~|gather~} takes a base pointer and an index vector.}
\li{\strong{Foreign functions.} Passing a vector to C or Rust depends on the target features of both sides.}
\li{\strong{First-faulting loads.} SVE has them and LLVM does not model them, so a scan may not read past the end of its buffer and uses a mask for the tail.}
\li{\strong{Two scalable dimensions.} Arm SME only.}
}
\transclude{prob-Y593}
\transclude{prob-I2N9}
\transclude{prob-C421}
}

\subtree[design-simd-vectors-plan]{
\title{Patch plan}

\p{A stack of pull requests of about 300 changed lines each, tests included. Each one is usable on its own and leaves the textual IR round trip complete.}

\p{\strong{Progress.} All patches are open as drafts, each on top of the one before: \pr{994}, \pr{995}, \pr{996}, \pr{997}, \pr{998}, \pr{999}, \pr{1000}, \pr{1001}, \pr{1002}, \pr{1003}, \pr{1004}, \pr{1005} and \pr{1006}. Patch 13 was dropped: \code{\verb~|from_array~} and \code{\verb~|to_array~} are a pointer load or store through \code{\verb~|array::unsafe_data_ptr~}, and \code{\verb~|vector.print~} lowers to calls into the MLIR runner utilities, which the Reussir runtime does not ship. \pr{1008} adds the scale-of-one fallback on top.}
\table{
\tr{\th{#}\th{Title}\th{Contents}}
\tr{\td{1}\td{\code{\verb~|[conversion]~} the \code{\verb~|vector~} dialect lowers through the pipeline}\td{Its conversion in \code{\verb~|reussir-convert-to-llvm~} and \code{\verb~|convert-to-llvm~}, with the SVE options on AArch64; lit tests for fixed, n-D and trailing-scalable shapes.}}
\tr{\td{2}\td{\code{\verb~|[core]~} the \code{\verb~|Simd~} type, fixed}\td{\code{\verb~|TyKind~}, element and extent rules, display, mangling, HIR and MIR text, MLIR type; a vector as parameter and result.}}
\tr{\td{3}\td{\code{\verb~|[core]~} scalable extents}\td{The bracket syntax, the last-extent rule, the storage rule with its instantiation-time check.}}
\tr{\td{4}\td{\code{\verb~|[core]~} construction and lane access}\td{The \code{\verb~|core::simd~} intrinsic family; \code{\verb~|splat~}, \code{\verb~|step~}, \code{\verb~|lanes~}, \code{\verb~|from_elements~}, \code{\verb~|extract~}, \code{\verb~|insert~}.}}
\tr{\td{5}\td{\code{\verb~|[core]~} lanewise arithmetic, comparison, \code{\verb~|select~}}\td{Unmasked functions.}}
\tr{\td{6}\td{\code{\verb~|[core]~} operators on vectors}\td{\code{\verb~|+ - * / % & | ^ << >>~}, unary \code{\verb~|-~} and \code{\verb~|!~}.}}
\tr{\td{7}\td{\code{\verb~|[core]~} masks and predication}\td{\code{\verb~|mask_first~}, \code{\verb~|any~}, \code{\verb~|all~}, \code{\verb~|count~}, \code{\verb~|first_set~}; the optional mask argument and its lowering.}}
\tr{\td{8}\td{\code{\verb~|[core]~} reductions}\td{\code{\verb~|reduce_<kind>~} and the reassociated sum and product.}}
\tr{\td{9}\td{\code{\verb~|[core]~} vectors through pointers}\td{A vector as the accessed type of \code{\verb~|ptr::load~}, \code{\verb~|store~}, \code{\verb~|type_offset~}, \code{\verb~|advance~}; masks in memory.}}
\tr{\td{10}\td{\code{\verb~|[conversion]~} \code{\verb~|[core]~} masked load and store}\td{Conversion of \code{\verb~|ptr.masked_load~} and \code{\verb~|ptr.masked_store~}; \code{\verb~|simd::load~}, \code{\verb~|simd::store~}.}}
\tr{\td{11}\td{\code{\verb~|[conversion]~} \code{\verb~|[core]~} gather, scatter, expand, compress}\td{Conversion of \code{\verb~|ptr.gather~} and \code{\verb~|ptr.scatter~}; the two Reussir operations; the four functions.}}
\tr{\td{12}\td{\code{\verb~|[core]~} shape operations}\td{\code{\verb~|shape_cast~}, \code{\verb~|bitcast~}, \code{\verb~|broadcast~}, \code{\verb~|transpose~}, \code{\verb~|shuffle~}, \code{\verb~|interleave~}, \code{\verb~|deinterleave~}, slices, scalable sub-vectors, \code{\verb~|outer~}; constant sequences as arguments.}}
\tr{\td{13}\td{\code{\verb~|[core]~} arrays and printing}\td{\code{\verb~|from_array~}, \code{\verb~|to_array~}, \code{\verb~|print~}.}}
\tr{\td{14}\td{\code{\verb~|[test]~} the examples end to end}\td{The examples of this note as tests, on fixed and scalable targets.}}
