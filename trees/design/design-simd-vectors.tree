\subtree[design-simd-vectors-open]{
\title{Open questions}

\ol{
\li{\strong{Operators.} Should \code{\verb~|a + b~} work on vectors, or only \code{\verb~|simd::add(a, b)~}? Operators read better; the builtin numeric traits would have to admit vectors, and a masked form still needs the function.}
\li{\strong{\code{\verb~|contract~}.} \code{\verb~|vector.contract~} takes indexing maps and iterator types. A general surface for it is large. Fixed forms such as \code{\verb~|dot~} and \code{\verb~|matmul~} could be offered instead, or it can wait.}
\li{\strong{Element types.} \code{\verb~|f16~}, \code{\verb~|bf16~}, \code{\verb~|i128~} and \code{\verb~|char~} lanes are left out. Vectors of pointers are left out; \code{\verb~|gather~} takes a base pointer and an index vector.}
\li{\strong{Foreign functions.} Passing a fixed vector to C or Rust depends on the target features of both sides. Left out at first.}
\li{\strong{Vector length at run time.} A scalable loop steps by \code{\verb~|lanes<V>()~}. First-faulting loads, which SVE has and LLVM does not model, are out of scope, so a scan may not read past the end of its buffer and uses a mask for the tail.}
\li{\strong{Where the masked memory operations live.} They are proposed as six operations under \code{\verb~|reussir.ptr~}. The alternative is to build a memref from the pointer and use the \code{\verb~|vector~} dialect operations, which needs a length the pointer does not have.}
}
}

\subtree[design-simd-vectors-plan]{
\title{Patch plan}

\p{A stack of pull requests of about 300 changed lines each, tests included. Each one is usable on its own and leaves the textual IR round trip complete.}
\table{
\tr{\th{#}\th{Title}\th{Contents}}
\tr{\td{1}\td{\code{\verb~|[conversion]~} the \code{\verb~|vector~} dialect lowers through the pipeline}\td{Register its conversion in \code{\verb~|reussir-convert-to-llvm~} and \code{\verb~|convert-to-llvm~}; lit tests for fixed, n-D and trailing-scalable shapes.}}
\tr{\td{2}\td{\code{\verb~|[core]~} the \code{\verb~|Simd~} type, fixed}\td{\code{\verb~|TyKind~}, element and extent rules, display, mangling, HIR and MIR text, MLIR type; a vector as parameter and result.}}
\tr{\td{3}\td{\code{\verb~|[core]~} scalable extents}\td{The bracket syntax, the last-extent rule, the storage rule with its instantiation-time check, \code{\verb~|lanes~}.}}
\tr{\td{4}\td{\code{\verb~|[core]~} construction and lane access}\td{The \code{\verb~|core::simd~} intrinsic family; \code{\verb~|splat~}, \code{\verb~|step~}, \code{\verb~|from_elements~}, \code{\verb~|extract~}, \code{\verb~|insert~}.}}
\tr{\td{5}\td{\code{\verb~|[core]~} lanewise arithmetic, comparison, \code{\verb~|select~}}\td{Unmasked forms only.}}
\tr{\td{6}\td{\code{\verb~|[core]~} masks and predication}\td{\code{\verb~|mask_first~}, \code{\verb~|mask_const~}, \code{\verb~|any~}, \code{\verb~|all~}, \code{\verb~|count~}, \code{\verb~|first_set~}; the optional mask argument and its lowering.}}
\tr{\td{7}\td{\code{\verb~|[core]~} reductions and scans}\td{\code{\verb~|reduce_<kind>~}, \code{\verb~|reduce_dims_<kind>~}, \code{\verb~|scan_<kind>~}, the reassociation flag.}}
\tr{\td{8}\td{\code{\verb~|[core]~} vectors through pointers}\td{A vector as the accessed type of \code{\verb~|ptr::load~}, \code{\verb~|store~}, \code{\verb~|type_offset~}, \code{\verb~|advance~}; masks in memory.}}
\tr{\td{9}\td{\code{\verb~|[conversion]~} \code{\verb~|[core]~} masked load and store}\td{\code{\verb~|reussir.ptr.masked_load~}, \code{\verb~|masked_store~} and \code{\verb~|simd::load~}, \code{\verb~|simd::store~}.}}
\tr{\td{10}\td{\code{\verb~|[conversion]~} \code{\verb~|[core]~} gather, scatter, expand, compress}\td{The four remaining memory operations.}}
\tr{\td{11}\td{\code{\verb~|[core]~} shape operations}\td{\code{\verb~|shape_cast~}, \code{\verb~|bitcast~}, \code{\verb~|broadcast~}, \code{\verb~|transpose~}, \code{\verb~|shuffle~}, \code{\verb~|interleave~}, \code{\verb~|deinterleave~}, slices, scalable sub-vectors, \code{\verb~|outer~}.}}
\tr{\td{12}\td{\code{\verb~|[core]~} arrays and printing}\td{\code{\verb~|from_array~}, \code{\verb~|to_array~}, \code{\verb~|print~}.}}
\tr{\td{13}\td{\code{\verb~|[test]~} the examples end to end}\td{The examples of this note as tests, run on fixed and scalable targets.}}
\tr{\td{14}\td{\code{\verb~|[core]~} operators, if wanted}\td{Depends on the first open question.}}
}
\p{Patches 4 to 7 and 11 add operations to one intrinsic family, so each of them is mostly a table of names, a checker arm, a lowering arm and tests.}
}

