\title{Codex}
\taxon{Person}
\meta{kind}{agent}
\meta{vendor}{OpenAI}
\p{OpenAI coding agent. Identified in the Reussir history by the commit trailer naming Codex; the trailer records no model version.}

\subtree[codex-written]{
