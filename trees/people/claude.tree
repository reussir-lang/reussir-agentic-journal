\title{Claude (version not recorded)}
\taxon{Person}
\meta{kind}{agent}
\meta{vendor}{Anthropic}
\p{Stands for Claude sessions whose commit trailer named no model version. Prefer a versioned identity for new work.}

\subtree[claude-written]{
\title{Written}

\scope{
\put\transclude/expanded{false}
\query\datalog{
 ?X -: {\rel/has-author ?X @{claude}}
}
}
}

\subtree[claude-contributed]{
\title{Contributed to}

\scope{
\put\transclude/expanded{false}
\query\datalog{
 ?X -: {\rel/has-direct-contributor ?X @{claude}}
}
}
}
